/* rs-theme-name: Flo's NEW Theme */
/* rs-theme-is-dark: TRUE */
.ace_gutter {
  background: #000c18;
  color: #6B7CA6;
}

.ace_print-margin {
  width: 2px;
  background: #101523;
}

.ace_editor {
  background-color: #000c18;
  color: #80a6e6;
}

.rstudio-themes-flat.ace_editor_theme {
  background-color: #000c18;
  color: #80a6e6;
}

.rstudio-themes-flat.ace_editor_theme .profvis-flamegraph {
  background-color: #000c18;
  color: #80a6e6;
}

.rstudio-themes-flat .ace_editor_theme {
  background-color: #000c18;
  color: #80a6e6;
}

.rstudio-themes-flat.editor_dark.ace_editor_theme a {
  color: #80a6e6 !important;
}

.rstudio-themes-flat .gwt-Label {
  color: #80a6e6;
}

.ace_cursor {
  color: #80a6e6;
}

.normal-mode .ace_cursor {
  border: 0 !important;
  background-color: #80a6e6;
}

/* --- Selections & markers --- */
.ace_marker-layer .ace_selection {
  background: #343946 !important; /* darker for better contrast */
}

.ace_marker-layer .ace_step {
  background: #f7fcbd;
}

.ace_marker-layer .ace_bracket {
  margin: -1px 0 0 -1px;
  border: 1px solid rgba(248, 248, 242, 0.4);
}

.ace_marker-layer .ace_active-line {
  background: #101523;
}

/* Cooler, lower-chroma find/selected-word highlight */
.ace_marker-layer .ace_find_match {
  background: #394860 !important;
  border: 1px solid #394860 !important;
}

.ace_marker-layer .ace_selected-word {
  background-color: #394860 !important;
  border-radius: 3px;
}

/* Keep a subtle cue for selection start */
.ace_marker-layer .ace_selection.ace_start {
  background-color: #9aa4b8 !important;
}

.ace_marker-layer .ace_foreign_line,
.ace_marker-layer .ace_active_debug_line {
  position: absolute;
  z-index: -1;
  background-color: #101523;
}

.ace_marker-layer .ace_find_line {
  position: absolute;
  z-index: -1;
  background-color: #464B5D80;
}

.ace_gutter-active-line {
  background-color: #000c18;
}

.ace_fold {
  background-color: rgba(248, 248, 242, 0.5);
  border: 1px solid #80a6e6 !important;
}

.ace_indent-guide {
  border-right: 1px solid rgba(248, 248, 242, 0.3);
  margin-right: -1px;
}

.ace_active-line ~ .ace_selection.ace_start {
  background-color: #101523;
}

/* --- Syntax colors --- */
.ace_keyword {
  font-style: normal;
  color: #DE5960; /* was #d1474e */
}

.ace_keyword.ace_operator {
  font-style: normal;
  color: #e06c6c;
}

.ace_keyword.ace_other.ace_unit {
  font-style: normal;
  color: #e06c6c;
}

.ace_constant.ace_language {
  color: #DE5960; /* was #d1474e */
}

.ace_constant.ace_numeric,
.ace_constant.ace_character,
.ace_support.ace_constant {
  color: #e06c6c;
}

.ace_constant.ace_other {
  color: #80a6e6;
}

.ace_support.ace_function,
.ace_entity.ace_name.ace_function {
  color: #32bb8d;
}

.ace_support.ace_class,
.ace_support.ace_type,
.ace_meta.ace_tag,
.ace_markup.ace_href {
  color: #7cbce6;
}

.ace_paren.ace_keyword.ace_operator {
  color: #80a6e6;
}

.ace_storage,
.ace_storage.ace_type,
.ace_entity.ace_other.ace_attribute-name {
  color: #DE5960; /* was #d1474e */
}

.ace_invalid {
  background-color: rgba(248, 248, 242, 0.5);
}

.ace_invalid.ace_deprecated {
  background-color: rgba(189, 147, 249, 0.5);
}

.ace_string,
.ace_entity.ace_name.ace_tag {
  color: #E7DA8C; /* softer yellow */
}

.ace_comment {
  color: #9aa4b8;
}

.ace_invisible {
  color: rgba(248, 248, 242, 0.3);
}

.ace_variable,
.ace_identifier {
  color: #80a6e6;
  background-color: inherit;
}

.ace_variable.ace_parameter,
.ace_support.ace_function.ace_codebegin,
.ace_support.ace_function.ace_codeend {
  color: #ffb86c;
}

.ace_bracket {
  margin: 0 !important;
  border: 0 !important;
  background-color: rgba(248, 248, 242, 0.4);
}

.ace_console_error {
  background-color: #464B5D80;
}

.ace_layer { z-index: 4; }
.ace_layer.ace_print-margin-layer { z-index: 2; }
.ace_layer.ace_marker-layer { z-index: 1; }
.ace_layer.ace_cursor-layer { z-index: 3; }

.ace_selection.ace_start {
  box-shadow: 0 0 3px 0 #000c18;
  border-radius: 2px;
}

.ace_markup.ace_heading,
.ace_markup.ace_heading ~ .ace_heading {
  font-weight: bold;
  color: #ffa94d;
}

.nocolor.ace_editor .ace_line span {
  color: #DE5960 !important; /* was #d1474e */
}

#rstudio_console_input .ace_marker-layer .ace_selection {
  background: #343946 !important;
}

/* ---- RStudio Theme ---- */
/* background */
.rstudio-themes-flat .rstudio-themes-dark-grey {
  background: #000000 !important;
  color: #80a6e6 !important;
  /* collapsed toolbar on rstudio server */
}

.rstudio-themes-flat .rstudio-themes-dark-grey .rstudio-themes-background {
  background: #000000 !important;
}

.rstudio-themes-flat .rstudio-themes-dark-grey [role="banner"] + [role="navigation"] > table > tbody > tr > td,
.rstudio-themes-flat .rstudio-themes-dark-grey header + [role="navigation"] > table > tbody > tr > td {
  background: #000000;
  border-color: #000c18;
}

.rstudio-themes-flat .rstudio-themes-dark-grey .rstudio-themes-border {
  border-color: #000c18;
}

/* inactive tabs */
table.rstheme_tabLayoutCenter,
.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-TabLayoutPanelTabs,
.rstheme_multiPodUtilityTabArea {
  background: #000000 !important;
}

table.rstheme_tabLayoutCenter .gwt-Label,
.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-TabLayoutPanelTabs .gwt-Label,
.rstheme_multiPodUtilityTabArea .gwt-Label {
  color: #ADB5CB;
}

/* toolbar and selected tab */
.rstudio-themes-flat .rstudio-themes-dark-grey .rstheme_center,
.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTab-selected table.rstheme_tabLayoutCenter {
  background: #000000 !important;
}

.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-TabLayoutPanelTab-selected .gwt-Label {
  color: #80a6e6;
}

.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-TabLayoutPanelTab:hover .rstheme_tabLayoutCenter {
  background: #32343f !important;
}

.rstudio-themes-flat .rstheme_toolbarWrapper {
  background: #000000 !important;
}

.rstudio-themes-flat.editor_dark .ace_editor_theme .GCHYANPCGI {
  color: #ADB5CB;
}

.rstudio-themes-flat .rstheme_toolbarWrapper button,
.rstudio-themes-flat .rstheme_toolbarWrapper a,
.rstudio-themes-flat .rstheme_toolbarWrapper div {
  color: #ADB5CB !important;
}

.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-SplitLayoutPanel-HDragger,
.rstudio-themes-flat .rstudio-themes-dark-grey .gwt-SplitLayoutPanel-VDragger {
  /* spliters */
  background: transparent !important;
}

.rstudio-themes-flat .rstudio-themes-dark .search,
.rstudio-themes-flat.rstudio-themes-dark-menus .search {
  /* search */
  background: #000000 !important;
}

.rstudio-themes-flat #rstudio_workbench_panel_find_in_files td[colspan="2"] {
  /* file name in Find in Files */
  color: #DE5960; /* was #d1474e */
}

/* pane toolbars */
.rstheme_secondaryToolbar,
.rstudio-themes-flat .rstudio-themes-dark-grey .dataGridHeader {
  background: #000000 !important;
}

/* menu background */
.rstudio-themes-flat .popupMiddleCenter,
.rstudio-themes-flat .menuPopupMiddleCenter,
.rstudio-themes-flat .suggestPopupMiddleCenter {
  background: #000c18 !important;
  color: #80a6e6 !important;
}

.rstudio-themes-flat .popupMiddleCenter .item.item-selected,
.rstudio-themes-flat .menuPopupMiddleCenter .item.item-selected,
.rstudio-themes-flat .suggestPopupMiddleCenter .item.item-selected {
  color: #80a6e6 !important;
  background: #000000 !important;
}

.rstudio-themes-flat .themedPopupPanel {
  border: solid 1px #000000;
}

.rstudio-themes-flat .themedPopupPanel ~ div.popupContent div:nth-child(1) {
  border: solid 1px #000000;
}

.rstudio-themes-flat .popupContent {
  background: #000c18;
  color: #80a6e6;
  border-color: #000000;
}

.rstudio-themes-flat .popupContent:not(.popupMiddleCenterInner) div div:nth-child(2) {
  background-color: unset;
  border: none;
}

.rstudio-themes-flat .popupContent + .rstudio-themes-scrollbars {
  border-color: #000000;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent {
  background: #000c18;
  padding: 2px;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent table {
  background: #80a6e6;
  border: 0;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent table .gwt-Label {
  color: #000c18;
}

.rstudio-themes-flat.rstudio-themes-dark-menus .gwt-MenuItem.gwt-MenuItem-selected,
.rstudio-themes-flat.rstudio-themes-dark-menus .gwt-MenuItem.gwt-MenuItem-selected > table {
  background: #000000;
  color: #80a6e6;
}

/* datagrid */
.rstudio-themes-dark .dataGridHeader,
.rstudio-themes-dark tr[__gwt_header_row] > :-webkit-any(td, th),
.rstudio-themes-dark .dataTables_info {
  background-color: #000c18 !important;
  border-color: #000000 !important;
}

/* hacky toolbars section */
.rstudio-themes-flat .rstudio-themes-dark-grey { /* placeholder */ }

.rstudio-themes-flat .rstudio-themes-dark-grey .windowframe > div:last-child > div > div > div > div > div:not(.gwt-TabLayoutPanelTabs) {
  background: #000000 !important;
}

.rstudio-themes-flat .rstudio-themes-dark-grey .windowframe > div:last-child > div > div > div:nth-child(3) > div {
  background: #000000 !important;
}

/* Data Frame Preview */
.dataTables_wrapper thead th {
  background-color: #1a1b22 !important;
  color: #80a6e6 !important;
}

.dataTables_scrollBody table tbody td:first-child {
  background: #1a1b22 !important;
  color: #80a6e6 !important;
}

.dataTables_info {
  background: #1a1b22 !important;
  color: #80a6e6 !important;
}

.rstudio-themes-flat.rstudio-themes-dark-grey #rsGridData_info,
.rstudio-themes-flat.rstudio-themes-dark-grey table.dataTable thead th,
.rstudio-themes-flat.rstudio-themes-dark-grey table.dataTable thead td,
.rstudio-themes-flat.rstudio-themes-dark-grey table.dataTable tbody td {
  border-color: #000000;
}

/* scrollbars */
.rstudio-themes-flat {
  scrollbar-width: auto;
  scrollbar-color: #000000 #000c18;
}

.rstudio-themes-flat ::-webkit-scrollbar {
  width: auto;
}

.rstudio-themes-flat *::-webkit-scrollbar-track {
  background: #000c18;
}

.rstudio-themes-flat *::-webkit-scrollbar-thumb {
  background-color: #000000;
  border-radius: 0px;
  border: 2px solid #000c18;
}

.rstudio-themes-flat *::-webkit-scrollbar-thumb:hover {
  background-color: #303140;
}

/* fix overly zealous css rules */
.gwt-DialogBox-ModalDialog .dialogContent .gwt-Label {
  color: #333333;
}

/* job progress bar */
.rstheme_toolbarWrapper [role="progressbar"] > div,
.windowframe [role="progressbar"] > div {
  background-color: #d1474e;
}

/* borders on toolbar under editor */
.rstudio-themes-flat .rstudio-themes-dark table.rstudio-themes-background td > div:first-child {
  border-color: #000000 !important;
}

/* Borrowed from https://github.com/anthonynorth/rscodeio */
/* splitters */
.rstudio-themes-flat > .rstudio-themes-dark .gwt-SplitLayoutPanel-HDragger {
  border-color: #000000;
}

.rstudio-themes-flat > .rstudio-themes-dark .gwt-SplitLayoutPanel-VDragger {
  border-color: #000000;
}

.rstudio-themes-flat > .rstudio-themes-dark .gwt-SplitLayoutPanel td {
  border-color: #000c18 !important;
}

/* window containers */
.rstudio-themes-flat > .rstudio-themes-dark :-webkit-any(.windowframe, .rstheme_minimizedWindowObject) > div:last-child {
  border-radius: 0;
  border-color: #000c18;
}

/* main toolbar */
.rstudio-themes-dark > div:last-child > div > div > .rstheme_toolbarWrapper,
.rstudio-themes-dark [role="application"] > div > .rstheme_toolbarWrapper {
  border-color: #000000;
}

/* toolbars */
.rstudio-themes-dark .rstheme_toolbarWrapper,
.rstudio-themes-dark .rstheme_secondaryToolbar {
  border-color: #000000 !important;
  border-radius: 0 !important;
}

/* other toolbars */
.rstudio-themes-dark .rstudio-themes-background {
  border-top-color: #000000 !important;
  border-bottom-color: #000000 !important;
  border-radius: 0 !important;
}

/* tabs container */
.rstudio-themes-dark .gwt-TabLayoutPanelTabs,
.rstudio-themes-dark .windowframe,
.rstudio-themes-dark :-webkit-any(.rstheme_multiPodUtilityTabArea, .GD15MCFCCS, .GJQ3LUQCCS) {
  background: #000000 !important;
  border-color: #000000 !important;
}

/* tabs */
.rstudio-themes-dark .gwt-TabLayoutPanelTab:not(.gwt-TabLayoutPanelTab-selected) .rstheme_tabLayoutCenter,
.rstudio-themes-dark .rstheme_minimizedWindowObject .rstheme_center {
  border-color: #000000 !important;
  border-right: 1px solid #000000 !important;
  border-radius: 0;
}

/* active tab */
.rstudio-themes-dark .gwt-TabLayoutPanelTab.gwt-TabLayoutPanelTab-selected .rstheme_tabLayoutCenter {
  border: none;
}

/* Terminal */
.terminal {
  background-color: #000c18;
  color: #80a6e6;
  font-feature-settings: "liga" 0;
  position: relative;
  user-select: none;
  -ms-user-select: none;
  -webkit-user-select: none;
}

.terminal.xterm-cursor-style-block.focus:not(.xterm-cursor-blink-on) .terminal-cursor {
  background-color: #80a6e6;
  color: #80a6e6;
}

.terminal.focus.xterm-cursor-style-bar:not(.xterm-cursor-blink-on) .terminal-cursor::before,
.terminal.focus.xterm-cursor-style-underline:not(.xterm-cursor-blink-on) .terminal-cursor::before {
  content: '';
  position: absolute;
  background-color: #000c18;
}

.terminal:not(.focus) .terminal-cursor {
  outline: 1px solid #80a6e6;
  outline-offset: -1px;
}

.terminal .xterm-selection {
  opacity: 1 !important;
  z-index: 0 !important;
}

.terminal .xterm-selection div {
  position: absolute;
  background-color: #464B5D80;
}

.terminal .xterm-viewport {
  background-color: #000c18;
  overflow-y: scroll;
}

/* 256-color table (unchanged except places you set specific brand colors) */
.xtermInvertColor { color: #80a6e6; }
.xtermInvertBgColor { background-color: #000c18; }
.xtermBold { font-weight: bold; }
.xtermUnderline { text-decoration: underline; }
.xtermBlink { text-decoration: blink; }
.xtermHidden { visibility: hidden; }
.xtermItalic { font-style: italic; }
.xtermStrike { text-decoration: line-through; }

/* … (keep the long xtermColor/xtermBgColor definitions as-is) … */

.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected .gwt-TabLayoutPanelTabInner .rstheme_tabLayoutCenter {
  box-shadow: 0 2px 0 #d1474e inset;
  border-radius: 0 !important;
}

.rstudio-themes-dark .dataGridHeader,
.rstudio-themes-dark tr[__gwt_header_row] > :-webkit-any(td, th),
.rstudio-themes-dark .dataTables_info {
  background-color: #000000 !important;
  border-color: #000000 !important;
}

#rstudio_command_palette_search,
#rstudio_command_palette_list [id^="rstudio_command_"],
input#rstudio_command_palette_search {
  background-color: #000c18;
  border: none;
}

#rstudio_command_palette_list {
  background-color: #000c18;
  border-color: #000c18;
}

.rstudio-themes-flat .rstudio-themes-border {
  border-color: #000c18;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"] table .gwt-Label,
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"] table td {
  background-color: #000c18;
  color: #80a6e6;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover,
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover [id^="rstudio_command_entry"],
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover table .gwt-Label,
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover table td {
  background-color: #333545;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"],
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] [id^="rstudio_command_entry"],
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] table .gwt-Label,
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] table td {
  background-color: #3e4153;
}

input#rstudio_command_palette_search {
  padding: 10px 0;
  width: 580px;
  border: none;
}

.js-focus-visible input#rstudio_command_palette_search {
  outline-offset: 5px !important;
}

.rstudio-themes-flat .popupContent [id^="rstudio_command"] [id^="rstudio_command_entry_"] .gwt-Label,
.rstudio-themes-flat .popupContent [id^="rstudio_command"] [id^="rstudio_command_entry_"] .gwt-Label span {
  border: none;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel > div[aria-hidden="true"] + div {
  height: 40px !important;
  background: #000000;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs table.rstheme_tabLayoutCenter {
  padding-left: 20px;
  padding-right: 20px;
  height: 40px;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs .rstheme_tabLayoutCenter td {
  vertical-align: middle !important;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs > div:empty {
  height: 40px !important;
}

.rstudio-themes-flat .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs {
  border-color: #000000 !important;
}

.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter tbody > tr > td:last-child > img { display: none; }
.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter:hover tbody > tr > td:last-child > img {
  display: inline-block; position: absolute !important; top: 0 !important; padding-left: 3px;
}

.rstudio-themes-flat .gwt-TabLayoutPanelTabs [id^="rstudio_workbench_"] .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter:hover tbody > tr > td:last-child > img {
  padding-top: 5px;
}

.rstudio-themes-flat .windowframe .gwt-TabLayoutPanel > div:last-child,
.rstudio-themes-flat .gwt-TabLayoutPanel.rstudio_source_panel > div:last-child {
  top: 38px !important;
}

.windowframe > div:last-child > div > div > div[aria-hidden="true"] + div + div {
  height: 40px !important;
}

.rstudio-themes-flat [id^="rstudio_dialog"],
.rstudio-themes-flat :not(.gwt-MenuItem-selected):not(.gwt-MenuItem) > [id^="rstudio_label"],
.rstudio-themes-flat .dialogContent [id^="rstudio_label_"][id$="_panel"] :not(button) > table > tbody > td,
.rstudio-themes-flat .dialogTopCenter,
.rstudio-themes-flat .dialogTop,
.rstudio-themes-flat .dialogMiddle,
.rstudio-themes-flat .dataGridHeader {
  background: #000000 !important;
  color: #80a6e6 !important;
}

.rstudio-themes-flat .dialogContent > table:first-child:last-child :not(button) > table,
.rstudio-themes-flat .dialogContent > table:first-child:last-child :not(button) > table > tbody > td {
  background: #000000 !important;
  color: #80a6e6 !important;
  border-color: #000000 !important;
}

.rstudio-themes-flat .dialogContent label.gwt-Label { color: #80a6e6 !important; }
.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelContent .gwt-Label:not(label) { color: #80a6e6 !important; }

.rstudio-themes-flat [id^="rstudio_dialog"],
.rstudio-themes-flat .dialogTop .dialogTopCenter,
.rstudio-themes-flat .gwt-DialogBox-ModalDialog,
.rstudio-themes-flat .dataGridHeader {
  border-color: #303140 !important;
}

.rstudio-themes-flat .dialogContent > table div,
.rstudio-themes-flat .dialogContent [id^="rstudio_label_"][id$="_panel"] table tbody td { border-color: #303140; }

.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelTab { border-color: #303140 !important; }

.rstudio-themes-flat [id^="rstudio_label"][aria-selected="true"] div,
.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelTab-selected div { background-color: transparent !important; }

.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction table,
.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction table td,
.rstudio-themes-flat .dialogContent button table,
.rstudio-themes-flat .dialogContent button:not(:hover) table > tbody > tr > td > div {
  background: #000000 !important; color: #80a6e6 !important; border: none !important; box-shadow: none !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] > div,
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] [role="option"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] [role="option"] .gwt-Label,
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="tablist"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="tablist"] [role="tab"]:not([aria-selected="true"]) .gwt-Label,
.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab {
  background: #000000 !important; color: #80a6e6 !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"] td,
.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab-selected {
  background-color: #303140 !important; border-color: #303140 !important; color: #80a6e6 !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab-selected .gwt-Label { color: #80a6e6 !important; }

.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"] td .gwt-Label { color: #80a6e6 !important; }

.rstudio-themes-flat .dialogContent button {
  border-width: 2px !important; border-style: solid !important; border-color: #303140 !important; border-radius: 3px !important;
}

.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction:hover table,
.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction:hover table div,
.rstudio-themes-flat .dialogContent button:hover,
.rstudio-themes-flat .dialogContent button:hover table,
.rstudio-themes-flat .dialogContent .gwt-Button:hover > table > tbody > tr > td,
.rstudio-themes-flat .dialogContent button:hover table > tbody > tr > td > div {
  color: #80a6e6 !important; background: #32343f !important; border-color: #303140 !important;
}

.rstudio-themes-flat .dialogContent input { background: #000000 !important; color: #80a6e6 !important; border-color: #303140 !important; }
.rstudio-themes-flat .dialogContent input[type="checkbox"] { background: #303140 !important; color: #80a6e6 !important; }
.rstudio-themes-flat .dialogContent input[type="checkbox"]:checked::before {
  content: "\2713" !important; color: #80a6e6 !important; vertical-align: top; line-height: 1; font-weight: 600;
}

.rstudio-themes-flat .dialogContent select { background: #303140 !important; color: #80a6e6 !important; }

.rstudio-themes-flat .rstudio-HyperlinkLabel { color: #80a6e6; }

.rstudio-themes-flat .search { background-color: #000000; color: #80a6e6; }
.rstudio-themes-flat .search .rstheme_center img { display: none; }
.rstudio-themes-flat .search .rstheme_center::before { content: '\27a0'; color: #80a6e6; }
.rstudio-themes-flat .search .rstheme_center > button::before { content: '\2297'; color: #80a6e6; position: relative; top: -3px; font-size: 1.25em; }
.rstudio-themes-flat .search .rstheme_center > button:hover { background: unset !important; border: unset !important; }

/* Rainbow Parenthesis */
.rstudio-themes-dark .ace_paren_color_0 { color: #80a6e6; }
.rstudio-themes-dark .ace_paren_color_1 { color: #DE5960; } /* was #d1474e */
.rstudio-themes-dark .ace_paren_color_2 { color: #ffb86c; }
.rstudio-themes-dark .ace_paren_color_3 { color: #E7DA8C; }
.rstudio-themes-dark .ace_paren_color_4 { color: #32bb8d; }
.rstudio-themes-dark .ace_paren_color_5 { color: #7cbce6; }
.rstudio-themes-dark .ace_paren_color_6 { color: #DE5960; }

.gwt-DialogBox-ModalDialog .dialogContent .gwt-Label { color: #80a6e6; }

/* Choose layout of panels */
.GCHYANPCKRB td.GCHYANPCKRB {
  background-color: #000000;
  vertical-align: top;
  padding: 0;
  border: 0.5px solid #555;
  -moz-border-radius: 6px;
  -webkit-border-radius: 6px;
  border-radius: 6px;
}

.rstudio-themes-flat.editor_dark h1,
.rstudio-themes-flat.editor_dark h2,
.rstudio-themes-flat.editor_dark h3,
.rstudio-themes-flat.editor_dark h4 {
  color: #FAFBFF !important;
  background: none !important;
  border-color: #6a6a6a !important;
}

/* Switch projects window */
.GCHYANPCMUB {
  width: 400px;
  height: 170px;
  border: 1px solid #bbb;
  background-color: #000000;
}

.GCHYANPCBTB, .GCHYANPCITB, .GCHYANPCDUB, .GCHYANPCLTB { background: #000000; }
.GCHYANPCCTB, .GCHYANPCJTB, .GCHYANPCEUB, .GCHYANPCMTB, .GCHYANPCKTB { border: 2px solid #000000; }

.GCHYANPCLUB {
  color: #9aa4b8;
  font-size: 0.9em;
  word-wrap: break-word;
}

/* Import dialogs */
.GCHYANPCNTD {
  border: 1px solid #000000;
  background-color: #000000;
  padding-top: 12px; padding-left: 16px; padding-bottom: 3px; padding-right: 6px;
  display: -ms-flexbox; display: -webkit-flex; display: flex;
  -webkit-flex-direction: column; -ms-flex-direction: column; flex-direction: column;
  -ms-flex-grow: 1; -webkit-flex-grow: 1; flex-grow: 1;
  margin-top: 3px; margin-right: 5px; margin-left: 5px;
}

.gwt-DialogBox .dialogMiddleCenter, .GCHYANPCOR .popupMiddleCenter { background: #000000; }

.GCHYANPCCQD {
  width: calc(100% - 10px); height: 110px;
  border: 1px solid #999; background-color: #000000;
  margin-top: 5px; margin-right: 5px; margin-left: 5px;
}

/*Import text data import options*/
.GCHYANPCASD {
  display: -ms-flexbox; display: -webkit-flex; display: flex;
  -webkit-flex-direction: row; -ms-flex-direction: row; flex-direction: row;
  -ms-flex-grow: 1; -webkit-flex-grow: 1; flex-grow: 1;
  border: 1px solid #999; background-color: #000000;
  padding-top: 10px; padding-left: 10px; padding-bottom: 3px;
}

/*Import statistical data import options*/
.GCHYANPCPSD {
  border: 1px solid #999; background-color: #000000;
  padding-top: 12px; padding-left: 16px; padding-bottom: 3px; padding-right: 6px;
  display: -ms-flexbox; display: -webkit-flex; display: flex;
  -webkit-flex-direction: column; -ms-flex-direction: column; flex-direction: column;
  -ms-flex-grow: 1; -webkit-flex-grow: 1; flex-grow: 1;
  margin-top: 3px; margin-right: 5px; margin-left: 5px;
}

.rstudio-themes-flat.editor_dark .ace_editor_theme .GCHYANPCGI {
  color: #80a6e6;
}


/* a) Give the Replace field even more breathing room */
html body input[placeholder*="Replace"],
html body .rstudio-themes-flat .ace_replace_form input[type="text"] {
  padding-inline-start: 1.4ch !important;
  padding-left: 1.4ch !important;
}

/* b) As a last resort, hide any left-aligned icon background in the input */
html body .rstudio-themes-flat .ace_search input[type="text"] {
  background-image: none !important;
  background-position: left center !important; /* neutralize if theme adds one */
}

/* fine-tune Replace input offset */
html body input[placeholder*="Replace"],
html body .rstudio-themes-flat .ace_replace_form input[type="text"] {
  padding-inline-start: 1.7ch !important;
  padding-left: 1.7ch !important;
}

